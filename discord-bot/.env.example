# Copy this file to .env and fill in your own values.
# Get DISCORD_TOKEN and CLIENT_ID from https://discord.com/developers/applications
# -> your application -> "Bot" tab (token) and "General Information" tab (Application ID = CLIENT_ID).

DISCORD_TOKEN=
CLIENT_ID=

# Optional: while developing, set GUILD_ID to your test server's ID so slash commands
# register instantly (guild-scoped). Leave blank to register globally (can take up to ~1h
# to appear everywhere, but works in every server the bot is in).
GUILD_ID=

# Optional: default channel IDs used by /quest-announce and /report-issue.
# Both commands also let you pick/see a channel per-use where supported.
ANNOUNCE_CHANNEL_ID=
SUPPORT_CHANNEL_ID=
